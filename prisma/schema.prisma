// Kino — Telegram-native platforma ma'lumotlar modeli.
// Lokal test: SQLite. Production: provider'ni "postgresql" ga o'zgartiring.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   String   @unique
  username     String?
  firstName    String?
  languageCode String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  unlocks      Unlock[]
  views        View[]
  uploads      Content[]     @relation("creator")
  subscription Subscription?
  payouts      Payout[]
}

model Content {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  reelFileId      String? // qisqa REELS videoning Telegram file_id'si (Mini App'da ko'rsatiladi)
  videoFileId     String? // TO'LIQ videoning file_id'si (ochilganda chatga yuboriladi)
  priceStars      Int      @default(0) // 0 = bepul, >0 = Stars evaziga ochiladi
  status          String   @default("draft") // draft | pending | published | rejected
  rejectionReason String?
  creatorId       Int?
  creator         User?    @relation("creator", fields: [creatorId], references: [id])
  viewCount       Int      @default(0)
  unlockCount     Int      @default(0)
  createdAt       DateTime @default(now())

  unlocks Unlock[]
  views   View[]
}

model Unlock {
  id           Int      @id @default(autoincrement())
  userId       Int
  contentId    Int
  source       String   @default("stars") // stars | subscription | free
  starsPaid    Int      @default(0)
  creatorEarned Int     @default(0) // creator ulushi (Stars)
  platformFee  Int      @default(0) // platforma komissiyasi (Stars)
  chargeId     String? // telegram_payment_charge_id (refund uchun)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}

model View {
  id        Int      @id @default(autoincrement())
  userId    Int?
  contentId Int
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  status    String   @default("active") // active | expired | canceled
  until     DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Payout {
  id          Int      @id @default(autoincrement())
  userId      Int
  amountStars Int
  status      String   @default("requested") // requested | paid | rejected
  note        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
