// Kino — Telegram-native platforma ma'lumotlar modeli.
// Lokal test: SQLite. Production: provider'ni "postgresql" ga o'zgartiring.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   String   @unique
  username     String?
  firstName    String?
  languageCode String?
  lang          String? // tanlangan interfeys tili: uz | ru | en
  tonWallet     String? // yechish uchun TRC20 (TRON) hamyon manzili
  balanceUsdt   Float    @default(0) // ichki USDT balans (to'ldirish + daromad; sarflash/yechishdan kamayadi)
  acceptedTerms Boolean  @default(false) // foydalanish shartlarini qabul qilganmi
  isBanned      Boolean  @default(false) // bloklangan (yuklash/sotib olish/yechish taqiqlanadi)
  strikes       Int      @default(0) // moderatsiya ogohlantirishlari (limitда auto-ban)
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  unlocks  Unlock[]
  views    View[]
  uploads  Content[]     @relation("creator")
  likes    ContentLike[]
  saves    SavedItem[]
  payouts  Payout[]
  deposits Deposit[]
  ledger   LedgerEntry[]
}

// USDT-TRC20 to'ldirish (top-up) — noyob summa bo'yicha hot-wallet'ga kelgan to'lovni tanib olamiz
model Deposit {
  id             Int       @id @default(autoincrement())
  userId         Int
  address        String // kutilayotgan qabul manzili (hot-wallet)
  expectedAmount Float // moslash uchun noyob summa (6 kasr): masalan 5.004237
  status         String    @default("pending") // pending | credited | expired
  txHash         String?   @unique // kreditlangan on-chain tranzaksiya (ikki marta kreditlashning oldini oladi)
  actualAmount   Float?
  createdAt      DateTime  @default(now())
  creditedAt     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

// Pul harakati jurnali (audit + balansni tiklash uchun) — har o'zgarish bitta yozuv
model LedgerEntry {
  id           Int      @id @default(autoincrement())
  userId       Int
  deltaUsdt    Float // + kredit / - debet
  type         String // topup | purchase | earning | platform_fee | withdrawal | withdrawal_refund | refund_credit | refund_clawback | admin_adjust
  balanceAfter Float
  refType      String? // content | deposit | payout | refund
  refId        Int?
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Content {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  reelUrl         String? // qisqa REELS videoning AWS S3 (yoki CDN) URL'i — Mini App'da stream qilinadi
  reelFileId      String? // fallback: reel Telegram file_id (S3 sozlanmagan bo'lsa)
  videoFileId     String? // TO'LIQ videoning file_id'si (yopiq storage kanalda; unlock'da chatga yuboriladi)
  priceUsdt       Float    @default(0) // creator belgilagan narx (USDT); 0 = bepul
  priceStars      Int      @default(0) // USDT'dan hisoblangan Stars (invoice uchun; user shuni to'laydi)
  status          String   @default("draft") // draft | pending | published | rejected
  rejectionReason String?
  creatorId       Int?
  creator         User?    @relation("creator", fields: [creatorId], references: [id])
  viewCount       Int      @default(0)
  unlockCount     Int      @default(0)
  likeCount       Int      @default(0)
  saveCount       Int      @default(0)
  shareCount      Int      @default(0)
  createdAt       DateTime @default(now())

  unlocks    Unlock[]
  views      View[]
  likes      ContentLike[]
  saves      SavedItem[]
  orders     Order[]
  complaints Complaint[]
  reports    Report[]
}

// USDT (TON Connect) to'lov buyurtmasi — on-chain to'lovni aniqlash uchun
model Order {
  id         Int      @id @default(autoincrement())
  nonce      String   @unique // to'lov comment'i (on-chain moslash uchun)
  contentId  Int
  buyerTgId  String
  amountUsdt Float
  status     String   @default("pending") // pending | paid | expired
  txHash     String?
  fromAddr   String?
  attempts   Int      @default(0) // yetkazish urinishlari (idempotent retry uchun)
  createdAt  DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])

  @@index([status])
}

// "Aldov" shikoyati — reel to'liq videoga mos kelmasa
model Complaint {
  id        Int      @id @default(autoincrement())
  contentId Int
  userId    Int // shikoyatchi (xaridor)
  buyerTgId String
  reason    String?
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId]) // bir user bir kontentga bir marta
}

// Umumiy shikoyat (noqonuniy/nomaqbul kontent) — istalgan tomoshabin yubora oladi
model Report {
  id           Int      @id @default(autoincrement())
  contentId    Int
  reporterTgId String
  category     String // illegal | sexual | copyright | violence | other
  reason       String?
  status       String   @default("open") // open | actioned | dismissed
  createdAt    DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])

  @@index([status])
}

// Moderatsiya audit jurnali (dalil/hisobot uchun)
model ModerationLog {
  id        Int      @id @default(autoincrement())
  action    String // takedown | ban | unban | strike | dismiss | refund
  contentId Int?
  targetTgId String? // ta'sirlangan foydalanuvchi
  adminTgId String?
  note      String?
  createdAt DateTime @default(now())
}

// Pul qaytarish (refund) — 90% xaridorga, 10% komissiya qoladi
model Refund {
  id          Int      @id @default(autoincrement())
  contentId   Int
  buyerTgId   String
  toAddr      String? // (legacy on-chain refund uchun; endi balansga qaytariladi)
  amountUsdt  Float
  status      String   @default("credited") // credited (balansga) | processing | paid | failed
  txHash      String?
  cmOrderId   String? // (legacy)
  complaintId Int?
  createdAt   DateTime @default(now())

  @@index([status])
}

model Unlock {
  id            Int      @id @default(autoincrement())
  userId        Int
  contentId     Int
  source        String   @default("stars") // stars | free
  starsPaid     Int      @default(0)
  creatorEarned Int      @default(0) // (legacy) creator ulushi (Stars)
  platformFee   Int      @default(0) // (legacy) platforma komissiyasi (Stars)
  creatorEarnedUsdt Float @default(0) // creator ulushi (USDT) — balans shu bo'yicha
  platformFeeUsdt   Float @default(0) // platforma komissiyasi (USDT)
  refunded      Boolean  @default(false) // pul qaytarilganmi (aldov shikoyati bo'yicha)
  chargeId      String? // on-chain tx / charge id
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}

model ContentLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}

model SavedItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}

model View {
  id        Int      @id @default(autoincrement())
  userId    Int?
  contentId Int
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
}

model Payout {
  id          Int      @id @default(autoincrement())
  userId      Int
  amountStars Int      @default(0) // (legacy)
  amountUsdt  Float    @default(0) // yechilgan USDT
  toAddress   String? // qabul qiluvchining TRC20 (TRON) manzili
  txHash      String? // TRON tranzaksiya hash'i
  tonTxHash   String? // (legacy)
  status      String   @default("processing") // processing | paid | failed
  attempts    Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([status])
}
