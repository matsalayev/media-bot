# --- Telegram ---
# @BotFather'dan olingan token (siz keyin berasiz)
BOT_TOKEN=

# Mini App ochiladigan PUBLIC HTTPS manzil (server yoki tunnel URL).
# Masalan: https://kino.example.uz  yoki tunnel: https://xxxx.trycloudflare.com
WEBAPP_URL=

# Media proxy uchun bazaviy public URL (odatda WEBAPP_URL bilan bir xil).
PUBLIC_URL=

# Vergul bilan ajratilgan admin Telegram ID'lari (masalan: 123456789,987654321)
ADMIN_IDS=

# --- Server ---
PORT=3000

# --- Ma'lumotlar bazasi ---
# Lokal test uchun SQLite (hech narsa o'rnatish shart emas):
DATABASE_URL="file:./dev.db"
# Production (server)da PostgreSQL:
# DATABASE_URL="postgresql://user:pass@localhost:5432/kino?schema=public"

# --- Obuna (Stars) ---
SUB_PRICE_STARS=150
SUB_DAYS=30

# --- Creator ekonomikasi ---
# Creator paid-unlock'dan qancha % oladi (qolgani platforma komissiyasi)
CREATOR_SHARE_PERCENT=90
# Yechish (USDT) uchun minimal balans va tarmoq haqi
MIN_WITHDRAW_USDT=5
WITHDRAW_FEE_USDT=1.5

# --- Native TRON (USDT-TRC20) — o'zimizniki, uchinchi tomonsiz ---
# Hot-wallet: qabul (to'ldirish) + to'lov (payout) manzili. Kalit FAQAT shu yerda, git'ga TUSHMASIN.
TRON_HOTWALLET_ADDRESS=
TRON_HOTWALLET_PRIVKEY=
# TronGrid API kaliti (rate-limit uchun; https://www.trongrid.io dan bepul) — tavsiya etiladi
TRON_API_KEY=
# Ixtiyoriy (default'lar mos):
# TRON_FULL_HOST=https://api.trongrid.io
# USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# DEPOSIT_TTL_MIN=120
# PAYOUT_FEE_LIMIT_TRX=100
# TOPUP_AMOUNTS=3,5,10,20,50
# LOW_TRX_ALERT_TRX=40

# TO'LIQ videolar shu yopiq kanal/gurux'ga yuboriladi (cheksiz xotira).
# Bot shu kanalda admin bo'lishi kerak. Bo'sh bo'lsa — birinchi adminга yuboriladi.
# Masalan: -1001234567890
STORAGE_CHANNEL_ID=

# --- AWS S3 (REELS videolar shu yerdan stream qilinadi) ---
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Ixtiyoriy: CloudFront yoki maxsus CDN domeni (masalan https://cdn.example.com)
AWS_PUBLIC_BASE_URL=
