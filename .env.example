# --- Telegram ---
# @BotFather'dan olingan token (siz keyin berasiz)
BOT_TOKEN=

# Mini App ochiladigan PUBLIC HTTPS manzil (server yoki tunnel URL).
# Masalan: https://kino.example.uz  yoki tunnel: https://xxxx.trycloudflare.com
WEBAPP_URL=

# Media proxy uchun bazaviy public URL (odatda WEBAPP_URL bilan bir xil).
PUBLIC_URL=

# Vergul bilan ajratilgan admin Telegram ID'lari (masalan: 123456789,987654321)
ADMIN_IDS=

# --- Server ---
PORT=3000

# --- Ma'lumotlar bazasi ---
# Lokal test uchun SQLite (hech narsa o'rnatish shart emas):
DATABASE_URL="file:./dev.db"
# Production (server)da PostgreSQL:
# DATABASE_URL="postgresql://user:pass@localhost:5432/kino?schema=public"

# --- Obuna (Stars) ---
SUB_PRICE_STARS=150
SUB_DAYS=30

# --- Creator ekonomikasi ---
# Creator paid-unlock'dan qancha % oladi (qolgani platforma komissiyasi)
CREATOR_SHARE_PERCENT=70
# Payout (yechish) uchun minimal balans (Stars)
MIN_WITHDRAW_STARS=100

# TO'LIQ videolar shu yopiq kanal/gurux'ga yuboriladi (cheksiz xotira).
# Bot shu kanalda admin bo'lishi kerak. Bo'sh bo'lsa — birinchi adminга yuboriladi.
# Masalan: -1001234567890
STORAGE_CHANNEL_ID=

# --- AWS S3 (REELS videolar shu yerdan stream qilinadi) ---
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Ixtiyoriy: CloudFront yoki maxsus CDN domeni (masalan https://cdn.example.com)
AWS_PUBLIC_BASE_URL=
